@persistence(name='simple_object')
@name(label='简单对象', singular='simple_object', plural='simple_objects')
simple_object<
  
  @persistence(name='id')
  @name(label='标识')
  id!!: id,
  
  @persistence(name='name')
  @name(label='名称')
  name: string(100),
  
  @persistence(name='status')
  @name(label='状态')
  status: string(100),
  
  @persistence(name='created_time')
  @name(label='创建时间')
  created_time = now: datetime,
  
  @persistence(name='state')
  @name(label='系统状态状态')
  state: enum[E:有效,D:失效],
  
  @persistence(name='last_modified_time')
  @name(label='最后更新时间')
  last_modified_time: now
>

@persistence(name='another_object')
@name(label='另外对象', singular='another_object', plural='another_objects')
another_object<
  
  @persistence(name='id')
  @name(label='标识')
  id!!: id,
  
  @persistence(name='simpleid')
  @name(label='状态')
  simple_object: &simple_object(id),
  
  @persistence(name='status')
  @name(label='状态')
  status: string(100),
  
  @persistence(name='created_time')
  @name(label='创建时间')
  created_time = now: datetime,
  
  @persistence(name='state')
  @name(label='系统状态状态')
  state: enum[E:有效,D:失效],
  
  @persistence(name='last_modified_time')
  @name(label='最后更新时间')
  last_modified_time: now
  
>

@name(label='简单聚合对象', singular='simple_aggregate', plural='simple_aggregates')
simple_aggregate<
 
  @original(object='simple_object', attribute='id')
  @name(label='标识')
  simple_object_id!!: long,
  
  @original(object='simple_object', attribute='name')
  @name(label='名称')
  simple_object_name: string(100),
  
  @original(object='simple_object', attribute='status')
  @name(label='状态')
  status: string(100),
  
  @name(label='另外对象集合', singular='another')
  anothers: &another_object(id)[]
 
>
